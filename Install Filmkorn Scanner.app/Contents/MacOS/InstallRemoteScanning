#!/bin/bash
set -euo pipefail

HOST_DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
if [ -f "$HOST_DIR/host-computer/install_remote_scanning.command" ]; then
  COMMAND_FILE="$HOST_DIR/host-computer/install_remote_scanning.command"
elif [ -f "$HOST_DIR/install_remote_scanning.command" ]; then
  COMMAND_FILE="$HOST_DIR/install_remote_scanning.command"
else
  echo "Missing install_remote_scanning.command (looked in host-computer/ and $HOST_DIR)"
  exit 1
fi

open -a Terminal "$COMMAND_FILE"
